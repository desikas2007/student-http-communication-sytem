# ---------------------------------------------------------------
# Student-College HTTP Communication System - Server environment
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to Git.
# ---------------------------------------------------------------

# Port the Express server listens on
PORT=5000

# MongoDB Atlas connection string (do NOT hardcode this in source)
MONGODB_URI=your_mongodb_atlas_connection_string

# Secret used to sign/verify JWT tokens (use a long random string)
JWT_SECRET=your_secure_jwt_secret

# How long an access token stays valid
JWT_EXPIRES_IN=1d

# Allowed browser origin (Vite dev server)
CLIENT_URL=http://localhost:5173

# development | production | test
NODE_ENV=development
